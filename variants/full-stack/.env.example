# Runtime connection: Supabase TRANSACTION POOLER (port 6543), logged in as the
# non-owner app_runtime role. Through the pooler the username is
# app_runtime.<project-ref>. The string Supabase's dashboard shows you logs in as
# postgres instead: that login bypasses row-level security, so the app refuses to
# start on it. Swap in the app_runtime username and password.
# ?pgbouncer=true is REQUIRED — it disables Prisma's named prepared statements,
# which the pooler's transaction mode does not support. Removing it causes
# intermittent "prepared statement already exists" errors under concurrency.
DATABASE_URL="postgresql://app_runtime.YOUR-PROJECT-REF:RUNTIME-PASSWORD@YOUR-POOLER-HOST:6543/postgres?pgbouncer=true"

# Direct connection (port 5432). MIGRATIONS AND TESTS ONLY. Runs as the table owner.
# This one stays on your machine. It never goes in Vercel.
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Supabase Auth (PUBLIC by design — anon key is safe in the browser; protected by RLS).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Inngest (background jobs). Local dev uses the Inngest Dev Server; prod needs these.
INNGEST_EVENT_KEY="YOUR-EVENT-KEY"
INNGEST_SIGNING_KEY="YOUR-SIGNING-KEY"
